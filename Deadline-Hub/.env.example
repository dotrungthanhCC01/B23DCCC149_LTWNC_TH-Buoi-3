# Bắt buộc: chuỗi bí mật ký JWT (tạo bằng: npx auth secret)
AUTH_SECRET=thay-bang-chuoi-ngau-nhien
# URL gốc của site (dùng cho metadata, sitemap, OG image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tuỳ chọn (điểm cộng): đăng nhập GitHub OAuth
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
